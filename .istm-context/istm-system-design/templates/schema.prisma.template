// This is a dynamic Prisma schema template for @istmx/skills
// The orchestrator will inject the specific database provider and connection URLs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "{DB_PROVIDER}" // e.g., "postgresql", "mysql", "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE DOMAIN MODELS
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // {USER_RELATIONSHIPS}
}

// {ADDITIONAL_MODELS}
