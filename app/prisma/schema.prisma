generator client {
  provider = "prisma-client-js"
  output   = "../shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  avatarUrl     String?
  tokensBalance Int      @default(500)
  tokensUsed    Int      @default(0)
  tier          String   @default("FREE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  watches       Watch[]
}

model Watch {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  topic                  String
  searchQueries          String[] 
  frequency              String   
  significanceThreshold  Int     
  
  notificationEmail      String?
  notificationSlackWebhook String?
  
  active                 Boolean   @default(true)
  lastRunAt              DateTime? 
  runInProgress          Boolean   @default(false)
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  findings               Finding[]
  digests                Digest[]
}

model Finding {
  id            String   @id @default(cuid())
  watchId       String
  watch         Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  
  url           String
  title         String
  content       String
  score         Int      
  category      String
  keyFact       String
  
  createdAt     DateTime @default(now())
}

model Digest {
  id            String   @id @default(cuid())
  watchId       String
  watch         Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  
  summary       String   
  sentAt        DateTime @default(now())
}

